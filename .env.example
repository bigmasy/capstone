# Variables of docker-compose.yml. Copy this file to .env (ignored by git) and fill in the values;
# docker compose reads .env from this directory. Compose refuses to start while a required
# variable is empty. Generate each secret on your machine and never commit the result.
#
# The passwords are placed inside a database URL, so they must be URL-safe: letters and digits
# only. `openssl rand -hex 16` gives 32 such characters.

# Password of the bootstrap superuser of PostgreSQL; used only to create the roles.
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Password of adaptive_owner, the role that runs the migrations.
# Generate with: openssl rand -hex 16
DB_OWNER_PASSWORD=

# Password of adaptive_api, the role the running API connects as.
# Generate with: openssl rand -hex 16
DB_API_PASSWORD=

# Signing key of the access tokens, at least 32 bytes.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Only with `docker compose --profile demo up`: the shared password of the demo accounts
# (10 to 128 characters).
# Generate with: openssl rand -hex 12
SEED_PASSWORD=

# Only with the demo profile: number of demo accounts. Leave empty for the default of 200.
SEED_COUNT=

# Optional. Uncomment to change; the defaults are in the comments.
# BIND_ADDRESS=127.0.0.1
# HTTPS_PORT=8443
# HTTP_PORT=8080
# PUBLIC_HOSTNAME=localhost
