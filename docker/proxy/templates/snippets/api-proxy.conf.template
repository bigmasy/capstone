# Forwards a request to the API container. Included by the API locations.
include /etc/nginx/conf.d/snippets/security-headers.conf;

# A variable keeps nginx from resolving the name once at start; the original request URI is
# passed on unchanged because proxy_pass has no URI part.
set $api_upstream http://api:8000;
proxy_pass $api_upstream;
proxy_http_version 1.1;
proxy_set_header Connection "";

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
# Overwritten, not appended: this proxy is the edge, so a client-supplied value is not trusted.
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;

proxy_hide_header X-Powered-By;
proxy_hide_header Server;
proxy_connect_timeout 3s;
proxy_send_timeout 15s;
proxy_read_timeout 30s;
