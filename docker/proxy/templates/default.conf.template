# Reverse proxy of the stack: terminates TLS, applies the rate limits and routes
# /api/ to the API and everything else to the static frontend. Rendered by the image
# entrypoint (envsubst, only variables whose names start with PUBLIC_); nginx variables
# keep their $ untouched.
#
# The client address used for the limits is the peer address nginx sees, or, behind a trusted
# balancer (TRUSTED_PROXY in the compose file), the address that balancer reports.

server_tokens off;

# Behind a TLS-terminating balancer on the same host (for example Caddy) the peer address is the
# balancer. The client address is then taken from X-Forwarded-For, and only when the request
# comes from the trusted address; for a direct connection the default 127.0.0.1 never matches.
set_real_ip_from ${PUBLIC_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive off;

log_format minimal '$remote_addr $request_method $uri $status $body_bytes_sent $request_time';

# Request rate budgets per client address. A key that is empty is not counted, which is how
# the zones below apply to one method only.
map $request_method $post_key { POST $binary_remote_addr; default ""; }
map $request_method $put_key  { PUT  $binary_remote_addr; default ""; }

# Credential endpoints: online guessing and mass registration. 5 per minute, 5 more in a burst.
limit_req_zone $post_key zone=auth_login:10m    rate=5r/m;
limit_req_zone $post_key zone=auth_register:10m rate=5r/m;
# Confirmation of the e-mail address: the link is opened by a person, so a few tries are plenty;
# asking for the message again sends mail, so that is capped lower.
limit_req_zone $post_key zone=auth_verify:10m   rate=10r/m;
limit_req_zone $post_key zone=auth_resend:10m   rate=3r/m;
# Password recovery: asking for a link sends mail, so it is capped like the resend; using the
# link is a person's click or two.
limit_req_zone $post_key zone=auth_forgot:10m   rate=3r/m;
limit_req_zone $post_key zone=auth_reset:10m    rate=10r/m;
# Own-profile edits: repeated PUTs that move the location or the capabilities are the way to
# probe the matching (functional level, distance band), so the edit rate is capped per client.
limit_req_zone $put_key  zone=profile_write:10m rate=6r/m;
# Everything under /api/ and the static application.
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=web:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

limit_req_status 429;
limit_conn_status 429;
limit_req_log_level warn;
limit_conn_log_level warn;

# Slow-client and oversized-header protection.
client_header_timeout 10s;
client_body_timeout 10s;
send_timeout 15s;
large_client_header_buffers 4 8k;

# Docker's embedded resolver, so a recreated container is found again without a reload.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 8080 default_server;
    server_name _;
    access_log /dev/stdout minimal;

    # Plain HTTP carries nothing but the redirect. The target is fixed instead of built from
    # the Host header, so it cannot be turned into an open redirect.
    location / {
        return 301 https://${PUBLIC_HOSTNAME}:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    http2 on;
    server_name _;
    access_log /dev/stdout minimal;
    keepalive_timeout 15s;

    ssl_certificate     /certs/tls.crt;
    ssl_certificate_key /certs/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:ssl:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    include /etc/nginx/conf.d/snippets/security-headers.conf;

    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$) {
        return 405;
    }

    # Rejections made by nginx itself use the same JSON shape as the API errors.
    error_page 429 = @rate_limited;
    location @rate_limited {
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        default_type application/json;
        add_header Retry-After "12" always;
        return 429 '{"detail":"Too many requests"}';
    }

    # Probes of the API process, routed as they are (no /api prefix).
    location = /health {
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /ready {
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }

    # nginx applies the limit_req directives of the most specific location only, so the
    # general budget is repeated next to each specific one.
    location = /api/v1/auth/login {
        limit_req zone=auth_login burst=5 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 64k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /api/v1/auth/register {
        limit_req zone=auth_register burst=5 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 64k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /api/v1/auth/verify-email {
        limit_req zone=auth_verify burst=5 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 4k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /api/v1/auth/resend-verification {
        limit_req zone=auth_resend burst=2 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 1k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /api/v1/auth/forgot-password {
        limit_req zone=auth_forgot burst=2 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 1k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /api/v1/auth/reset-password {
        limit_req zone=auth_reset burst=5 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 4k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location = /api/v1/profiles/me {
        limit_req zone=profile_write burst=5 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 64k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    # The one route with a large body: a profile photograph, at most 2 MB. It shares the write
    # budget of the profile, which also keeps uploads from being used to fill the database.
    location = /api/v1/profiles/me/photo {
        limit_req zone=profile_write burst=5 nodelay;
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 2m;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        limit_conn conn_per_ip 20;
        client_max_body_size 64k;
        include /etc/nginx/conf.d/snippets/api-proxy.conf;
    }

    # The single-page application. Its own headers (including the content security policy)
    # come from the frontend container and pass through unchanged.
    location / {
        limit_req zone=web burst=60 nodelay;
        limit_conn conn_per_ip 50;
        add_header Strict-Transport-Security "${PUBLIC_HSTS}" always;
        set $web_upstream http://frontend:8080;
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
